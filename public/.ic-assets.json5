[
  {
    "match": "**/*",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com https://api.github.com https://*.workers.dev https://icp-api.io https://icp0.io https://*.icp0.io https://ic0.app https://*.ic0.app; frame-ancestors 'none'; base-uri 'self'",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "same-origin"
    },
    "allow_raw_access": false
  }
]
